{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "encounter_id",
    "event_time",
    "domain",
    "feature_name",
    "value"
  ],
  "properties": {
    "encounter_id": {
      "type": "string"
    },
    "event_time": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "feature_name": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "integer",
        "string",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
