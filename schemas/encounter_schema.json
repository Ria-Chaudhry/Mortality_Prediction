{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "encounter_id",
    "patient_id",
    "admit_time",
    "discharge_time"
  ],
  "properties": {
    "encounter_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "admit_time": {
      "type": "string"
    },
    "discharge_time": {
      "type": "string"
    },
    "age": {
      "type": [
        "number",
        "integer",
        "null"
      ]
    },
    "sex": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
