{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "encounter_id",
    "patient_id",
    "outcome",
    "y_score",
    "fold",
    "model_name"
  ],
  "properties": {
    "encounter_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "outcome": {
      "type": [
        "integer",
        "number",
        "boolean"
      ]
    },
    "y_score": {
      "type": "number"
    },
    "fold": {
      "type": "integer"
    },
    "model_name": {
      "type": "string"
    }
  }
}
